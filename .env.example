# ─── Discord ───────────────────────────────────────────────────────────────────
# Token do bot (Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=

# ID da aplicação (Discord Developer Portal → General Information → Application ID)
DISCORD_CLIENT_ID=

# ID do servidor onde os comandos serão registrados (clique direito no servidor → Copiar ID)
DISCORD_GUILD_ID=

# ─── n8n ───────────────────────────────────────────────────────────────────────
# URL do webhook do n8n responsável por processar as perguntas da IA (/help e menções)
N8N_WEBHOOK=

# ─── Supabase — Clientes ───────────────────────────────────────────────────────
# Instância com dados de lojas e programas (BD_Core_Stores, BD_Core_Programs)
SUPABASE_CLIENTES_URL=
SUPABASE_CLIENTES_ANON_KEY=

# ─── Supabase — Gestão ─────────────────────────────────────────────────────────
# Instância com dados de tickets (BD_Tickets)
SUPABASE_GESTAO_URL=
SUPABASE_GESTAO_ANON_KEY=

# ─── APIs Externas ─────────────────────────────────────────────────────────────
# Endpoint para obter e decodificar token da loja (/token)
TOKEN_ENDPOINT=

# Endpoint para geração de PIN via número de telefone (/pin)
PIN_ENDPOINT=
